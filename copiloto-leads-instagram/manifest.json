{
  "manifest_version": 3,
  "name": "Copiloto de Leads – Instagram",
  "version": "1.0.0",
  "description": "Captura comentários e perfis públicos que você está vendo no Instagram e qualifica leads com IA. Você navega, o copiloto organiza.",
  "permissions": ["storage", "clipboardWrite"],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://api.anthropic.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Abrir painel de leads",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
